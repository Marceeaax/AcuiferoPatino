DJANGO_SECRET_KEY=replace-me
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_TIME_ZONE=America/Asuncion
USE_WHITENOISE=true
STATIC_ROOT=
MEDIA_ROOT=

POSTGRES_DB=tesisdb
POSTGRES_USER=tesisuser
POSTGRES_PASSWORD=tesispassword
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Preferible en produccion cuando la plataforma la provee:
# DATABASE_URL=postgis://user:password@host:5432/database

# Email / SMTP
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=20
DEFAULT_FROM_EMAIL=
SERVER_EMAIL=
EMAIL_SUBJECT_PREFIX=[Acuifero Patino]
PASSWORD_RESET_TIMEOUT=259200

# URL base publica de la aplicacion (opcional para enlaces en correos)
APP_BASE_URL=
